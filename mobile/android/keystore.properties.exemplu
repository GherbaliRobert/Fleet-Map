# Copiază fișierul ăsta ca `keystore.properties` și completează-l.
# `keystore.properties` și `*.jks` sunt IGNORATE de git — nu le adăuga niciodată.
#
# Cheia se creează O SINGURĂ DATĂ:
#   keytool -genkeypair -v -keystore ratracks-release.jks -alias ratracks \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# ⚠ Păstrează fișierul .jks și parolele în seiful de parole ȘI într-o copie offline.
#   Dacă le pierzi, NU mai poți publica actualizări pentru cei care au deja aplicația
#   instalată — Android refuză o actualizare semnată cu altă cheie. Ar trebui să
#   publici o aplicație nouă și fiecare client s-o reinstaleze de la zero.

storeFile=ratracks-release.jks
storePassword=SCHIMBĂ-MĂ
keyAlias=ratracks
keyPassword=SCHIMBĂ-MĂ
