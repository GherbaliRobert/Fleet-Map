# Baza API. În dev (browser) lasă gol → se folosește proxy-ul Vite (/api → DEV_API).
# Pe device / build de producție, setează URL-ul absolut al backend-ului.
VITE_API_BASE=

# Folosit DOAR de Vite dev-server pentru proxy (nu ajunge în bundle).
DEV_API=http://localhost:3000

# URL-ul folosit pe device (build nativ). Lasă comentat în dev.
# VITE_API_BASE=https://ratrack.ro

# Push nativ (FCM). Implicit ACTIV la build (vezi vite.config.ts) pentru că google-services.json există.
# Setează 0 DOAR dacă vrei un build fără notificări.
VITE_ENABLE_PUSH=1
