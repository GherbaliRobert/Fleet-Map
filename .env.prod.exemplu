# Copiază fișierul ăsta ca `.env` pe server și completează-l.
#   cp .env.prod.exemplu .env && nano .env
# `.env` NU intră în git. Parolele de aici sunt cheile casei.

# ─── Obligatorii ──────────────────────────────────────────────────────────────────────────────────

# Domeniul pe care se vede interfața. Trebuie să aibă deja un A record către IP-ul serverului,
# ALTFEL Caddy nu poate obține certificatul și site-ul rămâne fără HTTPS.
DOMAIN=app.ratrack.ro

# Parola bazei de date. Nu iese niciodată în afara serverului — baza nu e expusă pe internet.
# Generează una: openssl rand -base64 24
DB_PASSWORD=

# Secretul cu care se semnează sesiunile. Dacă se schimbă, toți utilizatorii sunt delogați.
# Generează: openssl rand -hex 32
SESSION_SECRET=

# Parola contului de instalare, folosită O SINGURĂ DATĂ ca să intri prima oară.
# Îți faci imediat contul tău de super-admin, iar contul „admin" se retrage singur după aceea.
ADMIN_PASSWORD=

# ─── Portul trackerelor — CITEȘTE ASTA ────────────────────────────────────────────────────────────
# Portul pe care trackerele îl au configurate ACUM. Dacă îl pui exact pe cel vechi, mutarea
# înseamnă un singur rând de DNS schimbat și NICIUN tracker atins pe teren.
#   • Veniți de pe Railway? Portul e cel dat de proxy-ul lor (ex. 21015), NU 5027.
#     Îl vezi în Railway → serviciul app → Settings → Networking → TCP Proxy.
#   • Instalare nouă? Lasă 5027.
TCP_PUBLIC_PORT=5027

# ─── Recomandate ──────────────────────────────────────────────────────────────────────────────────

# Câte zile de poziții se păstrează. TimescaleDB o aplică singur, ca politică pe tabelă.
POSITION_RETENTION_DAYS=180

# Copia de rezervă în AFARA serverului. Fără ele, copia zilnică se face și se aruncă — iar un VPS
# e o singură mașină: dacă pică discul, nu mai există nimic. Codul REFUZĂ să urce o copie
# necriptată, deci fără parola de mai jos copia pur și simplu nu pleacă, chiar dacă restul e pus.
# ⚠ Parola se ține în ALT loc decât copia. Fără ea, copiile nu se pot restaura.
BACKUP_PASSPHRASE=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=

# Trimiterea de emailuri: invitații, resetări de parolă, rapoarte programate, facturi.
# ⚠ Completează-le pe TOATE. Aplicația se consideră configurată dacă are doar adresa și
# utilizatorul — fără parolă, crede că merge și trimiterile eșuează în tăcere.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Urmărirea erorilor în producție. O variabilă, zero cod de scris.
SENTRY_DSN=

# ─── Opționale ────────────────────────────────────────────────────────────────────────────────────

# Adresele de pe hartă, de la alt furnizor decât serverul public OpenStreetMap.
# GEOCODE_URL=https://eu1.locationiq.com/v1/reverse?key=CHEIA

# Lipirea traseului pe drumuri. Dacă rulezi OSRM pe același server: http://osrm:5000
# OSRM_URL=

# Pune-l pe „true" DOAR dacă traficul chiar vine prin Cloudflare. Altfel, oricine își poate
# falsifica adresa IP printr-un antet, iar jurnalul de audit devine inutilizabil.
TRUST_CF_IP=false

# Câte conexiuni simultane la baza de date. Pe server propriu nu mai ești legat de plafonul mic
# al unui plan găzduit; Postgres acceptă 100 implicit.
PG_POOL_MAX=24

# ─── Supraveghetorul recepției (pana tăcută) ───────────────────────────────────────────────
# Dacă aparatele sunt conectate dar niciunul nu mai trimite nimic, serverul anunță super-adminii
# (în aplicație + push), trimite un email la ALERT_EMAIL și apoi se repornește singur — Railway îl
# ridică la loc. Regula NU se declanșează când flota doarme: atunci aparatele sunt deconectate.
# ALERT_EMAIL=alerte@firma.ro          # fără ea, alerta rămâne doar în aplicație și pe telefon
# INGEST_SILENCE_MIN=30                # minute de tăcere (cu aparate conectate) până la alarmă
# WATCHDOG_RESTART=false               # alarmă DA, repornire automată NU
# WATCHDOG_ENABLED=false               # oprește complet supraveghetorul

# ─── Emailurile de alertă către agenda firmei ──────────────────────────────────────────────
# Adresele din agenda unei firme (dispecerat@, siguranta@) n-au cont, deci n-au praguri proprii:
# primesc evenimentele care trec pragul IMPLICIT al tipului, cu o pauză pe mașină și pe tip și cu
# un plafon zilnic pe firmă (ca o mașină cu senzor defect să nu ardă adresa de pe care trimitem).
# COMPANY_MAIL_COOLDOWN_MIN=60         # pauză între două emailuri de același fel, pe mașină
# COMPANY_MAIL_DAILY_MAX=50            # plafon pe zi și pe firmă

# ─── Pornirea serverului ───────────────────────────────────────────────────────────────────
# Câte zile de istoric se citesc la pornire ca să se umple harta live. Nesetat = se deduce din
# LIVE_PURGE_MS (implicit 24h), fiindcă tot ce e mai vechi e oricum scos din hartă. NU pune valori
# mari: pe o bază de 1000 de vehicule, citirea fără fereastră ținea pornirea 7-22 de secunde.
# BOOT_CACHE_DAYS=7
# CFG_FAIL_RETRY_MS=3000               # cât ținem ultima configurație bună după o eroare de citire
# BACKFILL_POSITIONS_COMPANY=true      # întreținere manuală, o singură pornire; vezi db.js/initDb

# ─── Conexiuni la bază: rezervă separată pentru recepția de la aparate ─────────────────────────
# Paginile, rapoartele și copiile zilnice folosesc PG_POOL_MAX conexiuni; recepția are în plus rezerva ei,
# ca un raport greu sau valul de pagini de după un deploy să nu mai țină aparatele fără confirmare.
# Total = PG_POOL_MAX + PG_POOL_INGEST_MAX; trebuie să încapă în max_connections al bazei (implicit 100).
# PG_POOL_INGEST_MAX=12
# O scriere de poziție care atârnă peste atât pică; aparatul nu primește confirmarea și retrimite.
# Doar pe rezerva recepției — conexiunile obișnuite NU au limită (migrările pot dura minute).
# INGEST_STATEMENT_TIMEOUT_MS=15000

# ─── Copiile zilnice ──────────────────────────────────────────────────────────────────────
# Backup-ul datelor de business și arhiva pozițiilor pe S3 rulează O DATĂ pe zi, după ora asta (ora României).
# Nu mai pornesc la fiecare repornire a serverului. Dacă serverul a stat oprit la ora programată, copia se
# face la prima verificare de după (din 10 în 10 minute).
# BACKUP_HOUR=3
# Câte rânduri citește backup-ul dintr-o dată, pe tabel. Mai mic = mai puțină memorie, mai multe cereri.
# BACKUP_BATCH=1000
