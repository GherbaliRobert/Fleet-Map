# ─── RA Tracks — configurare ───
# Toate variabilele sunt OPȚIONALE. Aplicația rulează 100% local, fără servicii externe,
# doar cu `npm start` (baza de date e embedded — PGlite, persistă în ./data).

# Porturi
PORT=3000                 # interfața web + API REST
TCP_PORT=5027             # portul pe care ascultă dispozitivele Teltonika

# Baza de date embedded (PGlite) — folder local. Implicit ./data/pgdata
# PGLITE_DIR=./data/pgdata

# Securitate
# SESSION_SECRET=         # dacă lipsește, se generează automat și se salvează în data/.session_secret
# ADMIN_PASSWORD=admin123 # parola contului admin (creat la prima pornire / resetat dacă e setată)
# COOKIE_SECURE=true      # activează DOAR în producție, pe HTTPS

# API
# API_CORS_ORIGIN=*       # activează CORS pentru /api (ex: *  sau  https://site.ro)

# ─── AI (asistent flotă + rezumate rapoarte) — OPȚIONAL, serviciu extern Anthropic ───
# Fără cheie, butoanele AI afișează „neconfigurat". Cheia se ia din https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-3-5-haiku-latest   # model implicit (poți pune sonnet pentru răspunsuri mai bune)

# ─── Demo mode (companie demo cu vehicule simulate + buton „Încearcă demo" pe landing) ───
# DEMO_DISABLED=true       # dezactivează complet modul demo (nu seedează compania/simulatorul)

# ─── e-Transport (ANAF) — OPȚIONAL ───
# Gestionarea codurilor UIT merge mereu local. Trimiterea pozițiilor la ANAF se activează
# DOAR când completezi ambele (token OAuth obținut din SPV + URL-ul API e-Transport).
# Schema payload-ului din server.js (sendEtransportPositions) trebuie aliniată la specificația ANAF.
# ANAF_ETRANSPORT_TOKEN=
# ANAF_ETRANSPORT_URL=

# Retenție date (opțional): șterge automat pozițiile mai vechi de N zile
# POSITION_RETENTION_DAYS=180

# ─── Notificări (toate canalele OPȚIONALE; centrul in-app merge mereu local) ───
# Avertizare expirare documente / mentenanță (zile înainte)
# NOTIFY_EXPIRY_DAYS=30
# Email prin SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# NOTIFY_EMAIL_TO=          # destinatar(i) alerte pe email
# Telegram (bot gratuit: creează unul cu @BotFather)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Webhook generic (primește POST JSON cu notificarea)
# NOTIFY_WEBHOOK_URL=
# Web Push (notificări push în browser) — cheile VAPID se generează automat (data/.vapid.json) dacă lipsesc
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@firma.ro

# ─── Integrări opționale (forward date Teltonika) ───
OPENREMOTE_ENABLED=false
OPENREMOTE_INGEST_URL=
OPENREMOTE_TOKEN=
OPENREMOTE_AUTH_HEADER=Authorization
OPENREMOTE_TIMEOUT_MS=3000

MIRROR_TELTONIKA_ENABLED=false
MIRROR_TELTONIKA_HOST=
MIRROR_TELTONIKA_PORT=
MIRROR_TELTONIKA_CONNECT_TIMEOUT_MS=3000
MIRROR_TELTONIKA_RECONNECT_MS=5000
MIRROR_TELTONIKA_QUEUE_MAX=200
