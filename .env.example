DATABASE_URL=postgresql://gps:gps_secret@db:5432/gps_tracker
PORT=3000
TCP_PORT=5027
SESSION_SECRET=your-random-secret-here
ADMIN_PASSWORD=admin123
\n+# Optional: forward decoded GPS/IO data to OpenRemote
OPENREMOTE_ENABLED=false
# Full ingest URL in your OpenRemote (e.g. a custom HTTP endpoint, HTTP Agent receiver, or attribute API)
# Example: https://manager.my-openremote.com/api/ingest
OPENREMOTE_INGEST_URL=
# Bearer token or API key
OPENREMOTE_TOKEN=
# Header name for auth (default Authorization). Set to X-Api-Key if you use an API key.
OPENREMOTE_AUTH_HEADER=Authorization
# HTTP request timeout in ms
OPENREMOTE_TIMEOUT_MS=3000

# Optional: raw Teltonika TCP mirror to Traccar/OpenRemote
# Example to send duplicates to gondola.proxy.rlwy.net:40590
MIRROR_TELTONIKA_ENABLED=false
MIRROR_TELTONIKA_HOST=
MIRROR_TELTONIKA_PORT=
MIRROR_TELTONIKA_CONNECT_TIMEOUT_MS=3000
MIRROR_TELTONIKA_RECONNECT_MS=5000
MIRROR_TELTONIKA_QUEUE_MAX=200
