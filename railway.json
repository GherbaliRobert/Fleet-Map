{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "**",
      "!/*.md",
      "!/docs/**",
      "!/docs_*/**",
      "!/verify_*.js",
      "!/*_smoke.js",
      "!/.github/**",
      "!/mobile/**"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/api",
    "healthcheckTimeout": 30
  }
}
